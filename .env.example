# BROWSER_BACKEND=ruyipage          # 鍞竴娴忚鍣ㄥ悗绔紱auto 浠呬綔涓哄吋瀹瑰埆鍚?
# RUYIPAGE_PYTHON=python3
# BROWSER_PROFILE_MODE=persistent   # persistent | fresh

# 娴忚鍣ㄧ櫥褰曠瓑寰咃紙姣锛?
# BROWSER_SIGN_IN_URL=https://appleid.apple.com/sign-in
# RUYIPAGE_BACKEND_TIMEOUT_MS=720000
# RUYIPAGE_KILL_GRACE_MS=5000
# BROWSER_2FA_SETTINGS_AFTER_MS=30000  # need_2fa 鍚?popup 涓荤獥鍙ｏ紱Allow 纭鍚庡彟鏈夊浐瀹?30 绉掑闄?
# BROWSER_2FA_SETTINGS_FALLBACK=1
# BROWSER_2FA_MANUAL_FALLBACK=1
# BROWSER_2FA_POLL_MS=800
# BROWSER_PRESERVE_ON_FAILURE=1  # direct-run failure keeps Firefox open for inspection
# BROWSER_PRESERVE_ON_SUCCESS=1  # keep the authenticated Firefox window and tab open
# BROWSER_ATTACH_EXISTING=1       # reuse an already-open account.apple.com tab when available
# BROWSER_ATTACH_ADDRESS=127.0.0.1:9222  # optional explicit ruyiPage attach address
# name=                           # populated from the authenticated personal-information page
# birthday=                       # populated from the authenticated personal-information page
