# Mac Settings SMS verification: enable only for the current terminal session; do not save secrets in .env.
# APPLE_AUTOMATION_SMS_ENABLED=1  # prompts for a phone number and hidden provider URL when both values are absent
# Phone numbers, provider URLs, and verification codes are runtime-only terminal input.
