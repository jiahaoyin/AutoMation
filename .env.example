# 运行 ./run.sh 时，账号和密码会在终端中提示输入，并自动写入 .env。
# 也可以先手动填写。
APPLE_ID=your@email.com
# Account 改密成功后会自动用新密码覆盖 APPLE_PASSWORD；不要提交真实 .env。
# 改密表单开始输入前会先写入 APPLE_PASSWORD_PENDING；若页面实际改密但确认判定异常，
# 请从该字段找回待确认的新密码。成功确认后该字段会由程序自动清理。
APPLE_PASSWORD=your_password
# APPLE_PASSWORD_PENDING=  # 仅运行期自动写入；不能提交

# 可选：Firefox / Camoufox
# FIREFOX_EXECUTABLE=/Applications/Firefox.app/Contents/MacOS/firefox
# FIREFOX_PROFILE_DIR=              # 默认扫描系统 Firefox 默认 profile（Dock/图标启动用的）
# BROWSER_BACKEND=camoufox          # 唯一浏览器后端；ruyipage / auto 为兼容别名
# CAMOUFOX_CHANNEL=official/prerelease   # 默认 FF152 dev 源（daijro/camoufox 最新预发布）
# CAMOUFOX_PYTHON=                  # 默认 .runtime/camoufox-venv
# RUYIPAGE_PYTHON=                  # 历史别名，等同 CAMOUFOX_PYTHON
# BROWSER_PROFILE_MODE=persistent   # persistent=系统默认 profile | fresh=每 run 隔离
# CAMOUFOX_PROXY_ENABLED=1
# CAMOUFOX_PROXY_SERVER=http://127.0.0.1:7890
# CAMOUFOX_PROXY_USERNAME=
# CAMOUFOX_PROXY_PASSWORD=
# CAMOUFOX_USE_SYSTEM_FIREFOX=0
# RUYIPAGE_BACKEND_TIMEOUT_MS=720000
# RUYIPAGE_KILL_GRACE_MS=5000
# BROWSER_2FA_SETTINGS_AFTER_MS=30000  # need_2fa 后先等待主弹窗；Allow 确认后另有固定 30 秒宽限
# BROWSER_2FA_SETTINGS_FALLBACK=1
# BROWSER_2FA_MANUAL_FALLBACK=1
# BROWSER_2FA_POLL_MS=800
# BROWSER_PRESERVE_ON_FAILURE=1  # 失败时保留浏览器供核对
# BROWSER_PRESERVE_ON_SUCCESS=1  # 成功后保留已登录窗口和标签页
# BROWSER_ATTACH_EXISTING=0       # Camoufox 不接管外部 Firefox；请先关闭图标启动的 Firefox
# DEVELOPER_MEMBERSHIP_GATE=0     # 测试默认：Developer 登录确认后，无论会员结果都继续 Account；设为 1 时仅已加入会员继续
# 终端诊断仅接受 shell/export 运行时开关，不从 .env 读取：
# APPLE_AUTOMATION_TERMINAL_DEBUG=1 ./run.sh --skip-mac
# name=                           # 已登录个人信息页采集后写入
# birthday=                       # 已登录个人信息页采集后写入
# developer_membership=           # 已加入 | 未加入 | 未确认（采集后写入）
# developer_registration_identity= # 会员详情卡注册身份（采集后写入）
# OTP 永远不会写入 audit、report、截图、错误文本或 .env。
# BROWSER_PAGE_SETTLE_MIN_MS=2000
# BROWSER_PAGE_SETTLE_MAX_MS=4000

# Mac 系统设置短信验证与后置动态接续默认均开启：未设置或设为 1 均为开启，设为 0 才关闭。
# 如需关闭短信自动处理，取消下一行注释；正常情况下无需配置此开关。
# 已有 .env 若保留旧的 =0，会继续关闭；删除该行或改为 1 即可重新开启。
# APPLE_AUTOMATION_SMS_ENABLED=0
# 仅保存受信任号码和私有 provider URL；.env 会以 0600 权限写入，且不会提交到 git。
APPLE_AUTOMATION_SMS_PHONE=
APPLE_AUTOMATION_SMS_API_URL=
# 重新配置开关：1=下次运行时重新输入号码和 URL；0=沿用已有配置（默认）。
# 格式校验通过后会自动改回 0 并覆盖旧值。
APPLE_AUTOMATION_SMS_RECONFIGURE=0

# 条款/定位页面会按动态状态机自动处理；Mac 密码与 iPhone 解锁码始终保留人工输入。
# 后置动态接续同样默认开启；如需关闭，取消下一行注释。
# 已有 .env 若保留旧的 =0，会继续关闭；删除该行或改为 1 即可重新开启。
# APPLE_AUTOMATION_POST_SMS_FINALIZATION_ENABLED=0
