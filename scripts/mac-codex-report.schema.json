{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apple-automation.local/schemas/mac-codex-report.schema.json",
  "title": "Mac Codex verification report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "taskUnderstanding",
    "environmentObservations",
    "commands",
    "tests",
    "findings",
    "recommendedWindowsActions",
    "status"
  ],
  "properties": {
    "taskUnderstanding": {
      "type": "string",
      "minLength": 1
    },
    "environmentObservations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["purpose", "command", "exitCode", "summary"],
        "properties": {
          "purpose": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "exitCode": { "type": "integer" },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "command", "status", "exitCode", "summary"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "status": { "enum": ["passed", "failed", "skipped"] },
          "exitCode": {
            "anyOf": [
              { "type": "integer" },
              { "type": "null" }
            ]
          },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "title", "details"],
        "properties": {
          "severity": {
            "enum": ["critical", "important", "warning", "info"]
          },
          "title": { "type": "string", "minLength": 1 },
          "details": { "type": "string", "minLength": 1 }
        }
      }
    },
    "recommendedWindowsActions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "enum": ["passed", "failed"]
    }
  }
}
